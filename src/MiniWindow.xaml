<Window x:Class="AirScope.MiniWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:AirScope.UI"
        Title="AirScope mini" Width="270" Height="132" WindowStyle="None" AllowsTransparency="True"
        Background="Transparent" Foreground="{StaticResource TextBrush}" FontFamily="{StaticResource UiFont}" FontSize="13" ResizeMode="NoResize" ShowInTaskbar="True" Topmost="True"
        MouseLeftButtonDown="OnDrag" MouseDoubleClick="OnDoubleClick">
    <Border Background="#EE161A21" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="12" Padding="12,10">
        <Border.ContextMenu>
            <ContextMenu>
                <MenuItem Header="Back to full view" Click="Close_Click"/>
                <MenuItem x:Name="TopItem" Header="Always on top" IsCheckable="True" Click="Top_Click"/>
            </ContextMenu>
        </Border.ContextMenu>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <DockPanel>
                <Button DockPanel.Dock="Right" Content="✕" Padding="6,0" FontSize="10" Click="Close_Click" ToolTip="Back to full view"
                        Background="Transparent" BorderThickness="0" VerticalAlignment="Top"/>
                <TextBlock x:Name="Rssi" Text="—" FontSize="30" FontWeight="SemiBold" FontFamily="{StaticResource MonoFont}"/>
                <StackPanel Margin="6,0,0,4" VerticalAlignment="Bottom">
                    <TextBlock Text="dBm" Foreground="{StaticResource Muted}" FontSize="11"/>
                    <TextBlock x:Name="Quality" FontSize="11" FontWeight="SemiBold"/>
                </StackPanel>
                <StackPanel HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,6,0">
                    <TextBlock x:Name="Tx" Foreground="#7AA2FF" FontSize="11.5" HorizontalAlignment="Right"/>
                    <TextBlock x:Name="Rx" Foreground="#C792EA" FontSize="11.5" HorizontalAlignment="Right"/>
                </StackPanel>
            </DockPanel>
            <ui:Sparkline x:Name="Spark" Grid.Row="1" Margin="0,4,0,4"/>
            <TextBlock x:Name="Info" Grid.Row="2" Foreground="{StaticResource Muted}" FontSize="11" TextTrimming="CharacterEllipsis"/>
        </Grid>
    </Border>
</Window>
